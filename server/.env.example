# AI Agent Failure Observatory — server environment.
#
# Dev mode is the default: leaving every production var below unset gives you
# embedded SQLite + file queue + local blob dir + no analytics sink, all under
# OBS_DATA_DIR. Set any production target and only that subsystem switches to
# the real adapter; the rest keep their dev fallbacks.
#
# Placeholders only — never put real credentials in this file.

# ---- Dev / shared (flags + env, all optional) ------------------------------
# OBS_ADDR=:8080
# OBS_DATA_DIR=./data
# OBS_LOG_LEVEL=info
# OBS_SEED_DEMO=true
# OBS_WEBHOOK_SECRET=
#   HMAC secret for signed webhooks; empty in dev (no signing verification).

# ---- Postgres metadata store (storepg) --------------------------------------
# OBS_DATABASE_URL=postgres://user:pass@host:5432/observatory
#   DSN for the Postgres metadata store. Unset = dev fallback: embedded
#   SQLite at $OBS_DATA_DIR/observatory.db. Schema comes from the Go-embedded
#   DDL in internal/storepg (mirrored in infrastructure/001_postgres.sql).

# ---- ClickHouse analytics sink (analyticsch) --------------------------------
# OBS_CLICKHOUSE_DSN=clickhouse://user:pass@host:8123/observatory
#   DSN for the ClickHouse analytics database. Unset = dev fallback: no
#   analytics mirroring. Tables are created by the server at startup
#   (embedded DDL; see infrastructure/001_clickhouse.sql).
# OBS_CH_FLUSH_INTERVAL=2s
# OBS_CH_FLUSH_MAX_ROWS=500
# OBS_CH_BUFFER_MAX_ROWS=100000
#   Write-path tuning: periodic flush interval, rows per flush trigger, and
#   the bounded in-memory buffer (overflow drops oldest rows, logged).
#   All optional, dev-safe defaults apply when unset.

# ---- NATS JetStream queue (queuenats) ---------------------------------------
# OBS_NATS_URL=nats://host:4222
#   Unset = dev fallback: durable file queue at $OBS_DATA_DIR/queue. Stream
#   and durable pull consumer are created lazily by the server.
# OBS_NATS_STREAM=observatory.events
#   JetStream stream name (default observatory.events). Subjects:
#   obs.<project>.events; durable consumer name is obs-workers.

# ---- S3/MinIO object store (blobs3) ------------------------------------------
# OBS_S3_ENDPOINT=http://minio:9000
# OBS_S3_BUCKET=observatory
# OBS_S3_ACCESS_KEY=
# OBS_S3_SECRET_KEY=
# OBS_S3_REGION=us-east-1
# OBS_S3_PATH_STYLE=true
#   Endpoint + bucket are both required to enable the S3 adapter; either
#   unset = dev fallback: local blob dir at $OBS_DATA_DIR/blobs. Objects are
#   stored already-redacted per the project payload policy — the store never
#   re-introduces raw content.
