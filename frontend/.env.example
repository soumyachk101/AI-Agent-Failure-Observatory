# Base URL of the Go Observatory API.
# Leave empty to use the Vite dev proxy (same origin, /v1).
# Set for a deployed static build, e.g. VITE_API_BASE=https://observatory.example.com
VITE_API_BASE=

# Bearer project API key. The server seeds a demo project ("demo") with the
# key "demo-key" when run with --seed-demo (default on). Demo-keyed data is
# sample data and the UI labels it as such.
VITE_API_KEY=demo-key

# Project id used when the key is for the seeded demo project.
VITE_PROJECT_ID=demo

# Target for the Vite dev proxy (used only by `npm run dev`).
OBS_API_TARGET=http://127.0.0.1:8080
